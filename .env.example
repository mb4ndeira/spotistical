# ── Spotify / Parquet ──────────────────────────────────────────────────────────
TRACKS_PARQUET_PATH=/data/spotify_processed.parquet

# ── The Guardian (fonte primária de notícias) ─────────────────────────────────
# Obter em: open-platform.theguardian.com/access → "Register for a developer key"
GUARDIAN_API_KEY=

# ── GDELT (fonte secundária — multilingual, sem API key) ──────────────────────
# Delay entre requests em segundos (GDELT documenta: 1 req/5s; default 6s + jitter)
# GDELT_REQUEST_DELAY=6
# GUARDIAN_REQUEST_DELAY=0.5

# ── PostgreSQL / TimescaleDB ───────────────────────────────────────────────────
# Admin user — full write access, used only by ingest routes
POSTGRES_USER=spotify
POSTGRES_PASSWORD=
POSTGRES_DB=spotify

# App user — read-only on source tables (tracks, news_events)
#            created automatically on first DB start via db/init.sh
POSTGRES_APP_USER=spotify_app
POSTGRES_APP_PASSWORD=

# ── Port overrides (optional) ─────────────────────────────────────────────────
# API_HOST_PORT=8000
# FRONTEND_HOST_PORT=5173
# DB_HOST_PORT=5432
